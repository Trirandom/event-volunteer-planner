# Only settings npm also understands live here. Everything pnpm-specific is in
# pnpm-workspace.yaml, so running an npm command in this tree does not print a
# page of "unknown project config" warnings and teach people to ignore them.

# The toolchain version is a gate, not a README line (docs/11 §1).
engine-strict=true

# Lockfile is authoritative; CI installs with --frozen-lockfile. A range in a
# manifest means two developers can compile different code from one commit.
save-exact=true
