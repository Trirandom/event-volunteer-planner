# Copy to .env only if you need to change something. Every value below has a
# working default baked into compose.override.yaml, which is why `docker compose
# up` works on a fresh clone with no .env at all.
#
# This file configures *Compose*. The application's own variables are in
# docs/06 §2 and are set by the compose files, not here.

# ── Ports on your machine ────────────────────────────────────────────────────
# Change these if something else already owns them. They are bound to
# 127.0.0.1 only (compose.override.yaml): the dev passwords below are public.
EVP_HTTP_PORT=8080
EVP_MAILPIT_UI_PORT=8025
EVP_DB_PORT=5432

# ── Development database credentials ─────────────────────────────────────────
# Fixtures, not secrets — the database is not published outside your machine.
# Production supplies the equivalents as Compose secrets; see compose.prod.yaml.
EVP_DB_SUPERUSER_PASSWORD=devsuper
EVP_DB_MIGRATOR_PASSWORD=devmigrator
EVP_DB_API_PASSWORD=devapi

# Changing any of the three above after the first start has no effect: the roles
# are created once, on an empty data directory. Run `just db-reset` to apply it.

# ── Logging ──────────────────────────────────────────────────────────────────
EVP_RUST_LOG=evp=debug,tower_http=debug,sqlx=warn

# ── The first owner ──────────────────────────────────────────────────────────
# Creates an owner and an organisation on a deployment that has no users yet,
# so that a fresh clone has a way in before SMTP or an identity provider is
# configured. Both must be set, or neither.
#
# Read ONLY while the `users` table is empty. Once an owner exists these are
# ignored on every subsequent start, so a typo here cannot mint a second owner
# on a system with real data, and an owner deleted on purpose does not come
# back at the next restart. Further owners are added by invitation (docs/07 M0).
#
# USERNAME is an email address, not a handle: the address is the account key,
# and it is what magic links and OIDC will match on when they land. A password
# is at least 12 characters; length is the only rule, because forcing a digit
# and a symbol produces `Password1!` across a whole deployment.
#
# In production prefer EVP_BOOTSTRAP_PASSWORD_FILE, naming a file: an
# environment value is visible in `docker inspect` and in any crash dump of the
# environment (docs/12 §5). Delete both once you have signed in — an unused
# credential in an environment is one nobody rotates.
#EVP_BOOTSTRAP_USERNAME=owner@example.org
#EVP_BOOTSTRAP_PASSWORD=change-this-long-passphrase
#EVP_BOOTSTRAP_ORG_NAME=My organisation

# ── Backoffice (ADR-0045) ────────────────────────────────────────────────────
# Opens http://localhost:8080/backoffice, where the operator creates
# organisations and accounts and assigns members to organisations. Unset or
# blank means the backoffice does not exist: its routes answer 404.
#
# At least 32 characters, refused at startup otherwise. It opens every
# organisation on this deployment, so generate it rather than choose it:
#   openssl rand -hex 32
# Set it for a setup session and remove it afterwards.
#EVP_BACKOFFICE_KEY=

# ── Sessions and sign-in rate limit ──────────────────────────────────────────
# Documented here for reference, but the compose files do not forward these to
# the api service yet: setting them in .env has no effect until a matching
# `environment:` entry is added to compose.override.yaml (or compose.prod.yaml).
#
# Absolute lifetime bounds what a stolen cookie is worth even on an active
# session; the idle timeout closes the laptop nobody logged out of.
#EVP_SESSION_ABSOLUTE_LIFETIME_HOURS=12
#EVP_SESSION_IDLE_TIMEOUT_MINUTES=480
#
# Per client address: BURST attempts back to back, one back every REPLENISH
# seconds, then 429 with Retry-After. The burst is sized for an office NAT — a
# dozen coordinators behind one address must not lock each other out — and the
# replenishment is what bounds a guessing attack (docs/12 §6).
#
# HOPS is how many reverse proxies stand in front of the API. The client address
# is read by counting that many entries from the RIGHT of X-Forwarded-For, so
# the part a client can write itself is ignored. 1 is Caddy, which is this
# stack; raise it only for a CDN in front of Caddy, and only to the exact hop
# count — one too many reads a value the client chose.
#EVP_TRUSTED_PROXY_HOPS=1
#EVP_LOGIN_RATE_LIMIT_BURST=10
#EVP_LOGIN_RATE_LIMIT_REPLENISH_SECONDS=15

# ── AGPL §13 ─────────────────────────────────────────────────────────────────
# Shown to every network user — coordinators and volunteers alike. A modified
# deployment MUST point this at its own fork.
EVP_SOURCE_URL=https://github.com/Trirandom/event-volunteer-planner
